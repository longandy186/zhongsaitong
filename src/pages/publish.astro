---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { FORM_ENDPOINT } from '../data/site';
---

<Base title="发布信息 · 中塞通">
  <Header />

  <section class="page-hero">
    <h1>发布信息</h1>
    <p>填写下方表单，审核通过后将在中塞通网站与公众号同步展示。</p>
  </section>

  <div class="notice">
    <div class="notice-icon" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
        <path d="M12 8v5M12 16h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </div>
    <div class="notice-body">
      <p>填写下方表单即可发布租房 / 二手 / 招聘 / 资讯 / 指南 / 供求信息。</p>
      <p class="notice-tip">提示：为保护隐私，联系方式默认不公开在详情页，有意的用户会通过你填写的联系方式与你联系。</p>
    </div>
  </div>

  <form
    action={FORM_ENDPOINT}
    method="POST"
    enctype="multipart/form-data"
    class="form-card"
  >
    <input type="hidden" name="_subject" value="中塞通新投稿" />
    <input type="hidden" name="_template" value="table" />
    <input type="hidden" name="_captcha" value="false" />

    <label class="field">
      <span class="field-label">信息类型 <em>*</em></span>
      <select name="category" required class="input">
        <option value="">请选择</option>
        <option value="rentals">租房</option>
        <option value="secondhand">二手交易</option>
        <option value="jobs">招聘求职</option>
        <option value="supply">供求对接（找货源 /找合作 /清库存）</option>
        <option value="news">新闻投稿（使馆 /商会 /要闻线索）</option>
        <option value="guide">指南投稿（经验攻略）</option>
      </select>
    </label>

    <label class="field">
      <span class="field-label">图片（可选）</span>
      <input name="images" type="text" placeholder="有配图请添加图片链接，或发布后发给管理员补图" class="input" />
    </label>

    <label class="field">
      <span class="field-label">标题 <em>*</em></span>
      <input name="title" type="text" required placeholder="如：泽蒙区二室一厅出租 / 冰柜转让 / 招聘中文翻译" class="input" />
    </label>

    <div class="field-row">
      <label class="field">
        <span class="field-label">价格（可选）</span>
        <input name="price" type="text" placeholder="如 700€/月" class="input" />
      </label>
      <label class="field">
        <span class="field-label">位置（可选）</span>
        <input name="location" type="text" placeholder="如 新贝·泽蒙" class="input" />
      </label>
    </div>

    <label class="field">
      <span class="field-label">详细描述 <em>*</em></span>
      <textarea name="body" rows="5" required placeholder="详细说明信息内容、成色、要求等" class="input"></textarea>
    </label>

    <label class="field">
      <span class="field-label">联系方式 <em>*</em></span>
      <input name="contact" type="text" required placeholder="微信 / 电话 / 邮箱" class="input" />
    </label>

    <button type="submit" class="btn-pink submit-btn">
      提交审核
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </form>
</Base>

<style>
  .page-hero { padding: 24px 16px 12px; max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 8px; }
  @media (min-width: 1024px) { .page-hero { padding: 36px 0 16px; } }
  .page-hero h1 { font-size: 26px; font-weight: 800; color: var(--ink); letter-spacing: -0.5px; }
  .page-hero p { font-size: 14px; color: var(--ink-2); line-height: 1.6; }

  .notice { margin: 0 16px; padding: 14px 16px; background: var(--pink-soft); border: 1px solid var(--wine); border-radius: var(--r-md); display: flex; gap: 10px; font-size: 13px; color: var(--ink); }
  @media (min-width: 1024px) { .notice { margin: 0; } }
  .notice-icon { flex-shrink: 0; font-size: 16px; }
  .notice-body { display: flex; flex-direction: column; gap: 4px; }
  .notice-tip { color: var(--ink-2); font-size: 12px; }

  .form-card { margin: 14px 16px 0; padding: 20px 16px; background: #fff; border-radius: var(--r-lg); display: flex; flex-direction: column; gap: 14px; max-width: 720px; }
  @media (min-width: 1024px) { .form-card { margin: 14px auto 0; padding: 24px 28px; } }

  .field { display: flex; flex-direction: column; gap: 6px; }
  .field-label { font-size: 13px; color: var(--ink-2); font-weight: 600; }
  .field-label em { color: var(--pink); font-style: normal; margin-left: 2px; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  @media (max-width: 480px) { .field-row { grid-template-columns: 1fr; } }
  .input {
    padding: 11px 14px; border: 1px solid var(--line); border-radius: 10px;
    font: inherit; background: #fff; color: var(--ink);
    transition: border-color .2s, box-shadow .2s;
    width: 100%;
  }
  .input:focus { outline: none; border-color: var(--wine); box-shadow: 0 0 0 3px var(--pink-soft); }
  textarea.input { resize: vertical; min-height: 100px; line-height: 1.6; }
  select.input { appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--ink-3) 50%), linear-gradient(135deg, var(--ink-3) 50%, transparent 50%); background-position: calc(100% - 18px) 50%, calc(100% - 13px) 50%; background-size: 5px 5px, 5px 5px; background-repeat: no-repeat; padding-right: 36px; }

  .btn-pink { background: var(--pink); color: #fff; border: 0; cursor: pointer; transition: background .2s, transform .15s; display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
  .btn-pink:hover { background: #E83A5A; }
  .btn-pink:active { transform: scale(0.97); }
  .submit-btn { padding: 13px; border-radius: 12px; font-size: 15px; font-weight: 700; margin-top: 6px; }
</style>