---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';

// 静态站点下服务端无法按 ?q= 过滤（构建期才执行），
// 因此这里渲染全部 active 卡片（每张带 data-search），
// 由客户端脚本读 URL 参数 / 输入框实时过滤。
const all = await getCollection('items');
const active = all
  .filter((i) => i.data.status === 'active')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="搜索 · 中塞通">
  <Header />

  <section class="search-hero">
    <h1>搜索</h1>
    <form action="/search" method="get" class="search-bar" role="search" id="search-form">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
        <path d="M16 16L21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <input
        id="search-input"
        name="q"
        type="search"
        placeholder="搜索房源、工作、资讯、指南…"
        aria-label="搜索"
        autocomplete="off"
      />
      <button type="submit" class="btn-pink">搜索</button>
    </form>
    <div class="search-meta" id="search-meta" hidden></div>
  </section>

  <div class="empty" id="search-empty">
    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="opacity:.35;">
      <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
      <path d="M16 16L21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
    <p id="empty-text">请输入关键词搜索</p>
    <div class="suggest">
      <span>试试：</span>
      <button type="button" class="suggest-btn" data-suggest="租房">租房</button>
      <button type="button" class="suggest-btn" data-suggest="招聘">招聘</button>
      <button type="button" class="suggest-btn" data-suggest="使馆">使馆</button>
    </div>
  </div>

  <div class="feed" id="search-feed" hidden>
    {active.map((item) => <Card item={item} />)}
    <button id="load-more" type="button" class="more-btn" hidden>
      查看更多 <span>→</span>
    </button>
  </div>
</Base>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const meta = document.getElementById('search-meta') as HTMLElement | null;
    const emptyBox = document.getElementById('search-empty') as HTMLElement | null;
    const emptyText = document.getElementById('empty-text') as HTMLElement | null;
    const feed = document.getElementById('search-feed') as HTMLElement | null;
    const moreBtn = document.getElementById('load-more') as HTMLButtonElement | null;
    if (!input || !feed) return;

    const cards = Array.from(feed.querySelectorAll<HTMLElement>('.card'));
    const PAGE = 12;
    let shown = PAGE;
    let currentQ = '';

    function applySearch(rawQ: string) {
      const q = rawQ.trim().toLowerCase();
      currentQ = q;
      // 命中过滤（data-search 已含标题/正文/位置/价格，小写去空白）
      let hits = 0;
      cards.forEach((c) => {
        const ok = q !== '' && (c.dataset.search ?? '').includes(q);
        c.style.display = ok ? '' : 'none';
        if (ok) hits++;
      });
      shown = PAGE;

      const hasQ = q !== '';
      if (meta) {
        meta.hidden = !hasQ;
        if (hasQ) meta.textContent = hits > 0 ? `找到 ${hits} 条与 "${q}" 相关的结果` : `没有找到与 "${q}" 相关的信息`;
      }
      if (emptyBox) {
        emptyBox.hidden = hasQ && hits > 0;
        if (emptyText) emptyText.textContent = hasQ ? `没有找到与 "${q}" 相关的信息` : '请输入关键词搜索';
      }
      if (feed) feed.hidden = hits === 0;
      if (moreBtn) moreBtn.hidden = hits <= PAGE;

      // 只显示前 PAGE 条，其余收进 load-more
      let shownCount = 0;
      cards.forEach((c) => {
        if (c.style.display === 'none') return;
        shownCount++;
        c.style.display = shownCount > PAGE ? 'none' : '';
      });
    }

    // 初始：读 URL 参数（GET 提交 / 直接访问 ?q=xxx）
    const params = new URLSearchParams(window.location.search);
    const urlQ = params.get('q') ?? '';
    input.value = urlQ;
    applySearch(urlQ);

    // 输入实时搜索
    input.addEventListener('input', () => {
      applySearch(input.value);
    });

    // 表单提交走 GET（保留 URL 可分享），阻止默认由浏览器带参跳转即可
    const form = document.getElementById('search-form') as HTMLFormElement | null;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      applySearch(input.value);
    });

    // 建议词点击即搜
    document.querySelectorAll<HTMLButtonElement>('[data-suggest]').forEach((b) => {
      b.addEventListener('click', () => {
        input.value = b.dataset.suggest ?? '';
        applySearch(input.value);
        input.focus();
      });
    });

    // 查看更多
    moreBtn?.addEventListener('click', () => {
      shown += PAGE;
      let shownCount = 0;
      cards.forEach((c) => {
        if (c.style.display === 'none') return;
        shownCount++;
        c.style.display = shownCount > shown ? 'none' : '';
      });
      if (moreBtn) moreBtn.hidden = shownCount <= shown;
    });
  });
</script>

<style>
  .search-hero { padding: 24px 16px 18px; display: flex; flex-direction: column; gap: 14px; max-width: 720px; margin: 0 auto; }
  @media (min-width: 1024px) { .search-hero { padding: 36px 0 24px; } }
  .search-hero h1 { font-size: 26px; font-weight: 800; color: var(--ink); letter-spacing: -0.5px; }
  .search-bar {
    display: flex; align-items: center; gap: 10px;
    background: #fff; border: 1px solid var(--line);
    border-radius: 999px; padding: 6px 6px 6px 18px;
    transition: border-color .2s, box-shadow .2s;
  }
  .search-bar:focus-within { border-color: var(--wine); box-shadow: 0 0 0 4px var(--pink-soft); }
  .search-bar svg { color: var(--ink-3); flex-shrink: 0; }
  .search-bar input {
    flex: 1; border: none; outline: none; background: transparent;
    font-size: 15px; color: var(--ink); padding: 8px 0; min-width: 0;
  }
  .search-bar input::placeholder { color: var(--ink-4); }
  .btn-pink { background: var(--pink); color: #fff; border: 0; border-radius: 999px; padding: 8px 22px; font-size: 14px; font-weight: 700; cursor: pointer; transition: background .2s; }
  .btn-pink:hover { background: #E83A5A; }
  .search-meta { font-size: 13px; color: var(--ink-2); padding-left: 4px; }

  .feed { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 12px 16px 4px; }
  @media (min-width: 1024px) { .feed { grid-template-columns: repeat(3, 1fr); gap: 18px; padding: 0; max-width: 1280px; margin: 0 auto; } }
  .more-btn { display: block; text-align: center; margin: 14px 16px 0; padding: 13px; border-radius: 14px; background: #fff; border: 0; color: var(--wine); font-weight: 600; font-size: 14px; }
  .more-btn:active { transform: scale(0.97); }
  @media (min-width: 1024px) { .more-btn { margin: 0; } }

  .empty { text-align: center; color: var(--ink-3); padding: 60px 16px; font-size: 14px; display: flex; flex-direction: column; gap: 12px; align-items: center; }
  .empty p { margin: 0; }
  .suggest { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: center; font-size: 13px; color: var(--ink-2); }
  .suggest-btn { background: var(--pink-soft); color: var(--wine); padding: 4px 12px; border-radius: 999px; font-size: 12px; border: 0; cursor: pointer; }
  .suggest-btn:hover { background: #EBD9DD; }
</style>
