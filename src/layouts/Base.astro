---
import { SITE } from '../data/site';
interface Props {
  title?: string;
  description?: string;
}
const { title = `${SITE.name} · ${SITE.tagline}`, description = SITE.description } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1A1A2E" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style is:global>
      :root {
        --ink: #1a1a2e;
        --crimson: #e94560;
        --crimson-dark: #c23648;
        --paper: #f8f9fa;
        --charcoal: #2d3436;
        --ash: #636e72;
        --mist: #dfe6e9;
        --amber: #fdcb6e;
        --green: #00b894;
        --blue: #0984e3;
        /* 兼容变量（组件引用名不变，只换值） */
        --red: #e94560;
        --red-dark: #c23648;
        --red-light: rgba(233, 69, 96, 0.1);
        --blue: #0984e3;
        --text: #2d3436;
        --text-secondary: #636e72;
        --text-tertiary: #8a9499;
        --bg: #f8f9fa;
        --card: #ffffff;
        --border: #dfe6e9;
        --radius: 20px;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Noto Sans SC',
          'Microsoft YaHei', 'Inter', system-ui, sans-serif;
        background: var(--paper);
        color: var(--charcoal);
        line-height: 1.6;
        font-size: 15px;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; display: block; }
      ::selection { background: var(--crimson); color: #fff; }
      ::-webkit-scrollbar { width: 4px; height: 4px; }
      ::-webkit-scrollbar-thumb { background: var(--mist); border-radius: 2px; }
      .container {
        max-width: 720px;
        margin: 0 auto;
        padding: 0 16px;
      }
      main { min-height: 70vh; padding-bottom: 60px; }
      .btn-primary {
        display: inline-block;
        background: var(--crimson);
        color: #fff;
        border: none;
        border-radius: 16px;
        padding: 8px 20px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
      }
      .btn-primary:hover { background: var(--crimson-dark); }
      .section-title {
        font-size: 17px;
        font-weight: 800;
        margin: 24px 0 12px;
        display: flex;
        align-items: center;
        gap: 8px;
        letter-spacing: -0.3px;
        color: var(--ink);
      }
      .section-title::before {
        content: '';
        width: 4px;
        height: 16px;
        background: var(--crimson);
        border-radius: 2px;
      }
      .empty { text-align: center; color: var(--text-tertiary); padding: 60px 0; font-size: 14px; }
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .animate-fade-up { animation: fadeUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    </style>
  </head>
  <body>
    <main class="container">
      <slot />
    </main>
    <footer style="text-align:center; padding: 32px 16px 48px; color: var(--text-tertiary); font-size: 13px; background: var(--ink); color: rgba(255,255,255,0.6);">
      <div style="margin-bottom:8px;">
        <span style="color:var(--crimson);font-weight:700;">{SITE.name}</span> · {SITE.tagline}
      </div>
      <div style="display:flex; justify-content:center; gap:20px; margin-bottom:12px; flex-wrap:wrap;">
        <a href="/publish/" style="color:rgba(255,255,255,0.85); font-weight:500;">发布信息</a>
        <a href="/advertise/" style="color:rgba(255,255,255,0.85); font-weight:500;">广告合作</a>
        <a href={`mailto:${SITE.email}`} style="color:rgba(255,255,255,0.85); font-weight:500;">联系编辑</a>
      </div>
      <div style="opacity:0.7;">关注公众号 · 视频号：中塞通 | 信息仅供交流参考，交易请自行核实</div>
      <div style="margin-top:6px; opacity:0.5;">内容来源见各条信息 · 转载需注明来源 · © {new Date().getFullYear()} {SITE.name}</div>
    </footer>
  </body>
</html>
