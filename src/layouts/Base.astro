---
import { SITE } from '../data/site';
interface Props {
  title?: string;
  description?: string;
  canonical?: string; // 覆盖默认 canonical（用于旧 /post/ 页指向新 URL）
}
const {
  title = `${SITE.name} · ${SITE.tagline}`,
  description = SITE.description,
  canonical: canonicalProp,
} = Astro.props;
const canonical = canonicalProp
  ? new URL(canonicalProp, SITE.url).href
  : new URL(Astro.url.pathname, SITE.url).href;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#7B1E3B" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="中塞通" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "中塞通",
        "alternateName": "ZhongSaiTong",
        "description": "塞尔维亚华人信息平台，提供每日要闻、使馆/商会动态、房源、招聘、生活指南与汇率天气工具",
        "url": "https://zhongsaitong.pages.dev/",
        "sameAs": []
      }
    </script>
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "中塞通",
        "url": "https://zhongsaitong.pages.dev/",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://zhongsaitong.pages.dev/search?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    </script>
    <style is:global>
      :root {
        /* v2 品牌色（酒红 · 塞尔维亚元素） */
        --wine: #7B1E3B;
        --wine-deep: #5C1429;
        --wine-dark: #2A1620;
        --pink: #FF4D6D;
        --pink-soft: #F3E8EA;
        /* 标签 5 色 */
        --t-wine: #7B1E3B;
        --t-blue: #2E86C1;
        --t-green: #27AE60;
        --t-orange: #EA580C;
        --t-purple: #8E44AD;
        /* 圆角 / 阴影 */
        --r-sm: 8px; --r-md: 12px; --r-lg: 16px; --r-xl: 20px;
        --shadow-sm: 0 1px 2px rgba(0,0,0,.04);
        --shadow-md: 0 4px 12px rgba(0,0,0,.06);
        --shadow-lg: 0 10px 24px rgba(0,0,0,.08);
        --shadow-fab: 0 6px 16px rgba(0,0,0,.22);
        /* 兼容变量（组件引用名不变，只换值） */
        --ink: #1F1B2E;
        --crimson: #7B1E3B;
        --crimson-dark: #5C1429;
        --paper: #F7F5F3;
        --charcoal: #1F1B2E;
        --ash: #8A8A93;
        --mist: #E3E0DB;
        --amber: #FDCB6E;
        --green: #27AE60;
        --blue: #2E86C1;
        --red: #FF4D6D;
        --red-dark: #E84A64;
        --red-light: rgba(255, 77, 109, 0.1);
        --text: #1F1B2E;
        --text-secondary: #5A5861;
        --text-tertiary: #8A8A93;
        --bg: #F7F5F3;
        --card: #FFFFFF;
        --border: #E3E0DB;
        --radius: 12px;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Noto Sans SC',
          'Microsoft YaHei', 'Inter', system-ui, sans-serif;
        background: var(--paper);
        color: var(--charcoal);
        line-height: 1.6;
        font-size: 15px;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; display: block; }
      ::selection { background: var(--crimson); color: #fff; }
      ::-webkit-scrollbar { width: 4px; height: 4px; }
      ::-webkit-scrollbar-thumb { background: var(--mist); border-radius: 2px; }
      .container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 16px;
      }
      main { min-height: 70vh; padding-bottom: 60px; }
      .btn-primary {
        display: inline-block;
        background: var(--crimson);
        color: #fff;
        border: none;
        border-radius: 16px;
        padding: 8px 20px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
      }
      .btn-primary:hover { background: var(--crimson-dark); }
      .section-title {
        font-size: 17px;
        font-weight: 800;
        margin: 24px 0 12px;
        display: flex;
        align-items: center;
        gap: 8px;
        letter-spacing: -0.3px;
        color: var(--ink);
      }
      .section-title::before {
        content: '';
        width: 4px;
        height: 16px;
        background: var(--crimson);
        border-radius: 2px;
      }
      .empty { text-align: center; color: var(--text-tertiary); padding: 60px 0; font-size: 14px; }
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .animate-fade-up { animation: fadeUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    </style>
  </head>
  <body>
    <main class="container">
      <slot />
    </main>
    <footer style="text-align:center; padding: 32px 16px 48px; color: var(--text-tertiary); font-size: 13px; background: var(--ink); color: rgba(255,255,255,0.6);">
      <div style="margin-bottom:8px;">
        <span style="color:var(--crimson);font-weight:700;">{SITE.name}</span> · {SITE.tagline}
      </div>
      <div style="display:flex; justify-content:center; gap:20px; margin-bottom:12px; flex-wrap:wrap;">
        <a href="/publish/" style="color:rgba(255,255,255,0.85); font-weight:500;">发布信息</a>
        <a href="/advertise/" style="color:rgba(255,255,255,0.85); font-weight:500;">广告合作</a>
        <a href="/about/" style="color:rgba(255,255,255,0.85); font-weight:500;">关于我们</a>
        <a href={`mailto:${SITE.email}`} style="color:rgba(255,255,255,0.85); font-weight:500;">联系编辑</a>
      </div>
      <div style="opacity:0.7;">关注公众号 · 视频号：中塞通 | 信息仅供交流参考，交易请自行核实</div>
      <div style="margin-top:6px; opacity:0.5;">内容来源见各条信息 · 转载需注明来源 · © {new Date().getFullYear()} {SITE.name}</div>
    </footer>
  </body>
</html>
