---
---

<div class="tools">
  <div class="tools-head">
    <div class="tools-temp" data-bind="temp">—°</div>
    <div class="tools-info">
      <div class="tools-l1" data-bind="city">多云 · 贝尔格莱德</div>
      <div class="tools-l2" data-bind="meta">风 — · 湿度 —</div>
      <div class="tools-dress" data-bind="dress">穿衣指数：—</div>
    </div>
    <div class="tools-up">
      <div class="up-t1" data-bind="update-label">每日 8:00</div>
      <div class="up-t2">自动更新</div>
    </div>
  </div>
  <a href="/tools/scan/" class="scan-btn">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="3" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
      <rect x="14" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
      <rect x="3" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
      <path d="M14 14h3v3h-3zM20 14h1M14 20h1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
    扫价签帮你算价格
  </a>
</div>

<script>
  const WMO: Record<number, string> = {
    0: '晴', 1: '大致晴朗', 2: '多云', 3: '阴',
    45: '有雾', 48: '雾凇',
    51: '小毛毛雨', 53: '毛毛雨', 55: '大毛毛雨',
    61: '小雨', 63: '中雨', 65: '大雨',
    71: '小雪', 73: '中雪', 75: '大雪',
    80: '阵雨', 81: '强阵雨', 82: '猛烈阵雨',
    95: '雷阵雨', 96: '雷阵雨伴冰雹', 99: '强雷暴',
  };
  function bind(name: string) {
    return document.querySelectorAll(`[data-bind="${name}"]`);
  }
  function windLevel(kmh: number): string {
    if (kmh < 1) return '0级 无风';
    if (kmh < 6) return '1级 软风';
    if (kmh < 12) return '2级 轻风';
    if (kmh < 20) return '3级 微风';
    if (kmh < 29) return '4级 和风';
    if (kmh < 39) return '5级 清风';
    if (kmh < 50) return '6级 强风';
    return '7级+ 大风';
  }
  function dressIndex(temp: number): string {
    if (temp >= 30) return '清凉夏装：短袖/短裤/防晒';
    if (temp >= 25) return '短袖/薄长裤';
    if (temp >= 20) return '长袖/薄外套';
    if (temp >= 15) return '卫衣/夹克';
    if (temp >= 10) return '厚外套/毛衣';
    if (temp >= 5) return '大衣/加绒';
    return '羽绒服';
  }
  async function loadStatus() {
    // 天气：open-meteo 免费无 Key，贝尔格莱德，含湿度风速
    try {
      const url =
        'https://api.open-meteo.com/v1/forecast' +
        '?latitude=44.7866&longitude=20.4489' +
        '&current_weather=true' +
        '&hourly=relativehumidity_2m,windspeed_10m' +
        '&timezone=Europe/Belgrade';
      const r = await fetch(url);
      const d = await r.json();
      const c = d?.current_weather;
      if (c) {
        bind('temp').forEach((el) => (el.textContent = `${Math.round(c.temperature)}°`));
        const cond = WMO[c.weathercode] ?? '多云';
        bind('city').forEach((el) => (el.textContent = `${cond} · 贝尔格莱德`));
        const windKmh = Math.round(c.windspeed);
        const now = new Date();
        const idx = d.hourly?.time?.findIndex((t: string) => t === now.toISOString().slice(0, 13) + ':00');
        const humid = idx != null && idx >= 0 ? d.hourly.relativehumidity_2m[idx] : null;
        const metaTxt = `风力 ${windLevel(windKmh)}${humid != null ? ` · 湿度 ${Math.round(humid)}%` : ''}`;
        bind('meta').forEach((el) => (el.textContent = metaTxt));
        bind('dress').forEach((el) => (el.textContent = `穿衣指数：${dressIndex(c.temperature)}`));
      }
    } catch { /* 降级 */ }
  }
  loadStatus();
</script>

<style>
  .tools {
    margin: 10px 16px 0;
    background: #fff;
    border-radius: var(--r-lg);
    padding: 14px;
  }
  @media (min-width: 1024px) { .tools { margin: 0; padding: 18px; border-radius: var(--r-lg); } }
  .tools-head { display: flex; align-items: center; gap: 10px; justify-content: space-between; }
  .tools-temp { font-size: 30px; font-weight: 700; color: var(--wine); line-height: 1; flex-shrink: 0; }
  .tools-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .tools-l1 { font-size: 14px; font-weight: 600; }
  .tools-l2 { font-size: 11px; color: var(--ink-3); }
  .tools-dress { font-size: 11px; color: var(--wine); font-weight: 600; }
  .tools-up { display: flex; flex-direction: column; align-items: flex-end; gap: 1px; flex-shrink: 0; }
  .up-t1 { font-size: 10px; font-weight: 600; color: var(--wine); }
  .up-t2 { font-size: 9px; color: var(--ink-3); }
  .scan-btn {
    margin-top: 10px;
    width: 100%;
    background: var(--ink);
    color: #fff;
    border-radius: var(--r-md);
    padding: 10px 14px;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    font-size: 13px; font-weight: 600;
    transition: background .2s;
  }
  .scan-btn:hover { background: #2D2638; }
  @media (min-width: 1024px) { .scan-btn { margin-top: 14px; } }
</style>
