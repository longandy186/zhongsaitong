---
import { TYPE_STYLE, CATEGORY_LABEL } from '../data/site';
import { itemUrl } from '../lib/itemUrl';
import type { CollectionEntry } from 'astro:content';

type Item = CollectionEntry<'items'>;

interface Props {
  item: Item;
}
const { item } = Astro.props;
const { data, body } = item;
const style = TYPE_STYLE[data.category];
const summary = (body ?? '').replace(/\s+/g, ' ').trim().slice(0, 40);
const cover = data.images[0];
const timeText = formatTime(data.date);
// 客户端搜索用的可检索文本（小写、去空白），覆盖标题/正文/位置/价格
const searchText = `${data.title} ${(body ?? '').replace(/\s+/g, ' ')} ${data.location ?? ''} ${data.price ?? ''}`
  .toLowerCase()
  .trim();

function formatTime(d: Date): string {
  const diff = Date.now() - d.getTime();
  const m = Math.floor(diff / 60000);
  if (m < 1) return '刚刚';
  if (m < 60) return `${m}分钟前`;
  const h = Math.floor(m / 60);
  if (h < 24) return `${h}小时前`;
  const days = Math.floor(h / 24);
  if (days < 30) return `${days}天前`;
  return `${d.getFullYear()}/${d.getMonth() + 1}/${d.getDate()}`;
}
---

<a href={itemUrl(item)} class="card" data-kind={data.kind} data-search={searchText}>
  {cover ? (
    <div class="card-img">
      <img src={cover} alt={data.title} loading="lazy" />
      {data.images.length > 1 && (
        <span class="img-count">{data.images.length}图</span>
      )}
    </div>
  ) : (
    <div class="card-banner" style={`background: linear-gradient(135deg, ${style.color}cc, ${style.color})`}>
      <span class="banner-tag">{style.label}</span>
      <span class="banner-text">{summary}</span>
    </div>
  )}

  <div class="card-body">
    <div class="card-tags">
      <span class="tag-mini" style={`background:${style.color}`}>{style.label}</span>
      <span class="cat-label">{CATEGORY_LABEL[data.category]}</span>
      {data.promoted && <span class="tag-soft">推广</span>}
      <span class="spacer"></span>
      <span class="time-mini">{timeText}</span>
    </div>
    <div class="card-title">{data.title}</div>
    {(data.price || data.location) && (
      <div class="card-price-row">
        {data.price && <span class="price">{data.price}</span>}
        {data.location && <span class="loc">{data.location}</span>}
      </div>
    )}
  </div>
</a>

<style>
  .card {
    background: #fff;
    border-radius: var(--r-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform .2s, box-shadow .2s;
  }
  .card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }

  .card-img { width: 100%; aspect-ratio: 4/3; position: relative; background: linear-gradient(135deg, #E8E2DC, #D5CEC7); overflow: hidden; }
  .card-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .img-count { position: absolute; right: 8px; top: 8px; background: rgba(0,0,0,.55); color: #fff; font-size: 10px; padding: 2px 6px; border-radius: 6px; }

  .card-banner { width: 100%; aspect-ratio: 4/3; padding: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; color: #fff; text-align: center; }
  .banner-tag { background: rgba(255,255,255,.95); padding: 3px 8px; border-radius: 4px; font-size: 10px; font-weight: 600; color: var(--ink-2); }
  .banner-text { font-size: 13px; font-weight: 600; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (min-width: 1024px) { .banner-text { font-size: 15px; } }

  .card-body { padding: 10px; display: flex; flex-direction: column; gap: 6px; }
  @media (min-width: 1024px) { .card-body { padding: 14px; gap: 8px; } }
  .card-tags { display: flex; gap: 6px; align-items: center; }
  .tag-mini { color: #fff; font-size: 10px; font-weight: 600; padding: 2px 6px; border-radius: 4px; flex-shrink: 0; }
  .cat-label { font-size: 10px; color: var(--ink-4); flex-shrink: 0; }
  .tag-soft { background: var(--pink-soft); color: var(--wine); font-size: 10px; font-weight: 500; padding: 2px 6px; border-radius: 4px; flex-shrink: 0; }
  .spacer { flex: 1; }
  .time-mini { font-size: 10px; color: var(--ink-4); flex-shrink: 0; }
  .card-title { font-size: 14px; font-weight: 600; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (min-width: 1024px) { .card-title { font-size: 15px; line-height: 1.4; } }
  .card-price-row { display: flex; justify-content: space-between; align-items: center; }
  .price { color: var(--wine); font-size: 15px; font-weight: 700; }
  @media (min-width: 1024px) { .price { font-size: 17px; } }
  .loc { color: var(--ink-4); font-size: 11px; }
</style>
