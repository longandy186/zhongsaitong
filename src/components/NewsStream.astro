---
import { getCollection } from 'astro:content';

const all = await getCollection('items');
const news = all
  .filter((i) => i.data.status === 'active' && i.data.category === 'news')
  .sort((a, b) => {
    const rank = { embassy: 0, chamber: 1, news: 2 };
    const r = (rank[a.data.kind] ?? 3) - (rank[b.data.kind] ?? 3);
    return r !== 0 ? r : b.data.date.getTime() - a.data.date.getTime();
  })
  .slice(0, 8);

const KIND_STYLE: Record<string, { label: string; color: string }> = {
  embassy: { label: '使馆', color: '#E94560' },
  chamber: { label: '商会', color: '#FDCB6E' },
  news: { label: '要闻', color: '#0984E3' },
};

function timeText(d: Date): string {
  const diff = Date.now() - d.getTime();
  const h = Math.floor(diff / 3600000);
  if (h < 1) return '刚刚';
  if (h < 24) return `${h}小时前`;
  return `${Math.floor(h / 24)}天前`;
}
---

<section class="news-stream">
  {news.length > 0 && (
    <div class="stream-header">
      <h2 class="stream-title">今日要闻</h2>
      <a href="/news/" class="stream-more">更多 <span class="arrow">→</span></a>
    </div>
  )}
  {news.length > 0 && (
    <div class="stream-scroll">
      {news.map((item, i) => {
        const ks = KIND_STYLE[item.data.kind] ?? KIND_STYLE.news;
        return (
          <a
            href={`/post/${item.id}/`}
            class="story-card animate-fade-up"
            style={`animation-delay: ${i * 0.06}s; border-top: 3px solid ${ks.color};`}
          >
            <span class="story-tag" style={`background: ${ks.color}18; color: ${ks.color};`}>
              {ks.label}
            </span>
            <h3 class="story-title">{item.data.title}</h3>
            <time class="story-time">{timeText(item.data.date)}</time>
          </a>
        );
      })}
    </div>
  )}
</section>

<style>
  .news-stream { padding: 16px 0 8px; }
  .stream-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 14px; padding: 0 2px; }
  .stream-title { font-size: 21px; font-weight: 800; color: var(--ink); letter-spacing: -0.5px; }
  .stream-more { font-size: 13px; color: var(--ash); font-weight: 600; }
  .stream-more .arrow { color: var(--crimson); margin-left: 2px; }
  .stream-scroll { display: flex; gap: 12px; padding: 4px 2px 12px; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
  .stream-scroll::-webkit-scrollbar { display: none; }
  .story-card {
    flex: 0 0 168px;
    height: 168px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    scroll-snap-align: start;
    transition: transform 0.2s ease;
    opacity: 0;
  }
  .story-card:active { transform: scale(0.96); }
  .story-tag { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; align-self: flex-start; }
  .story-title { font-size: 16px; font-weight: 700; color: var(--ink); line-height: 1.35; letter-spacing: -0.2px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .story-time { font-size: 12px; color: var(--ash); font-weight: 500; }
</style>
