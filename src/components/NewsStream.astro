---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { itemUrl } from '../lib/itemUrl';

type Item = CollectionEntry<'items'>;

interface Props {
  items?: Item[]; // 父组件(index)已算好的"今日要闻"：已去重、已限时 7 天
}
const { items } = Astro.props;

let news: Item[] = [];
if (items && items.length > 0) {
  news = items;
} else {
  const all = await getCollection('items');
  const SEVEN_DAYS = 7 * 24 * 3600 * 1000;
  news = all
    .filter(
      (i) =>
        i.data.status === 'active' &&
        i.data.category === 'news' &&
        Date.now() - i.data.date.getTime() <= SEVEN_DAYS
    )
    .sort((a, b) => {
      const rank = { embassy: 0, chamber: 1, news: 2 };
      const r = (rank[a.data.kind] ?? 3) - (rank[b.data.kind] ?? 3);
      return r !== 0 ? r : b.data.date.getTime() - a.data.date.getTime();
    })
    .slice(0, 6);
}

const KIND_STYLE: Record<string, { cls: string; label: string }> = {
  embassy: { cls: 'tb', label: '使馆' },
  chamber: { cls: 'tb', label: '商会' },
  news: { cls: 'tw', label: '要闻' },
};

function timeText(d: Date): string {
  const diff = Date.now() - d.getTime();
  const h = Math.floor(diff / 3600000);
  if (h < 1) return '刚刚';
  if (h < 24) return `${h}小时前`;
  return `${Math.floor(h / 24)}天前`;
}
---

{news.length > 0 && (
  <section>
    <div class="sec-head">
      <div class="sec-title">
        <div class="sec-bar"></div>
        <h2>今日要闻</h2>
        <span class="badge-count">{news.length}条</span>
      </div>
      <a href="/news/" class="sec-more">更多 →</a>
    </div>
    <div class="news-list">
      {news.map((item) => {
        const ks = KIND_STYLE[item.data.kind] ?? KIND_STYLE.news;
        return (
          <a class="news-item" href={itemUrl(item)}>
            <span class={`tag ${ks.cls}`}>{ks.label}</span>
            <span class="title">{item.data.title}</span>
            <span class="time">{timeText(item.data.date)}</span>
          </a>
        );
      })}
    </div>
  </section>
)}

<style>
  .sec-head { display: flex; align-items: center; justify-content: space-between; margin: 18px 16px 0; }
  @media (min-width: 1024px) { .sec-head { margin: 0; } }
  .sec-title { display: flex; align-items: center; gap: 8px; }
  .sec-bar { width: 4px; height: 18px; background: var(--wine); border-radius: 2px; }
  @media (min-width: 1024px) { .sec-bar { width: 5px; height: 22px; } }
  .sec-title h2 { font-size: 19px; font-weight: 700; }
  @media (min-width: 1024px) { .sec-title h2 { font-size: 22px; } }
  .badge-count { background: var(--pink-soft); color: var(--wine); font-size: 10px; font-weight: 600; padding: 3px 8px; border-radius: 8px; }
  @media (min-width: 1024px) { .badge-count { font-size: 11px; padding: 3px 9px; } }
  .sec-more { color: var(--wine); font-size: 12px; }
  @media (min-width: 1024px) { .sec-more { font-size: 13px; } }

  .news-list { margin: 10px 16px 0; background: #fff; border-radius: var(--r-md); overflow: hidden; }
  @media (min-width: 1024px) { .news-list { margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; background: transparent; } }
  .news-item { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-bottom: 1px solid var(--line-soft); }
  .news-item:last-child { border-bottom: none; }
  @media (min-width: 1024px) {
    .news-item {
      flex-direction: column; align-items: flex-start; gap: 8px;
      padding: 14px; background: #fff; border-radius: var(--r-md);
      border: none; transition: transform .2s, box-shadow .2s;
    }
    .news-item:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
  }
  .news-item .tag { flex-shrink: 0; color: #fff; font-size: 10px; font-weight: 600; padding: 3px 8px; border-radius: 4px; }
  .news-item .title { flex: 1; font-size: 14px; line-height: 20px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (min-width: 1024px) { .news-item .title { font-size: 15px; line-height: 21px; } }
  .news-item .time { color: var(--ink-4); font-size: 11px; flex-shrink: 0; }
  .tw { background: var(--t-wine); }
  .tb { background: var(--t-blue); }
</style>
