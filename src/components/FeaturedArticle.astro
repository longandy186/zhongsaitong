---
import { getCollection } from 'astro:content';
import { itemUrl } from '../lib/itemUrl';
import { cleanSummary } from '../lib/summary';

const all = await getCollection('items');
const guides = all
  .filter((i) => i.data.status === 'active' && i.data.category === 'guide')
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      b.data.date.getTime() - a.data.date.getTime()
  );
const guide = guides[0];
const summary = guide ? cleanSummary(guide, 90) : '';
---

{guide && (
  <div class="guide">
    <div class="guide-img">
      {guide.data.images[0] ? (
        <img src={guide.data.images[0]} alt={guide.data.title} loading="lazy" />
      ) : (
        <span class="guide-img-text">指南</span>
      )}
    </div>
    <div class="guide-body">
      <span class="guide-tag">深度指南</span>
      <div class="guide-title">{guide.data.title}</div>
      <div class="guide-desc">{summary}</div>
      <a href={itemUrl(guide)} class="guide-more">
        阅读全文
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
)}

<style>
  .guide {
    margin: 12px 16px 0;
    background: #fff;
    border-radius: var(--r-md);
    overflow: hidden;
    display: flex;
  }
  @media (min-width: 1024px) { .guide { margin: 0; border-radius: var(--r-lg); } }
  .guide-img {
    width: 130px; min-height: 118px; height: 100%; align-self: stretch;
    background: linear-gradient(135deg, #C8A06E, #8B5E2F);
    flex-shrink: 0;
    position: relative;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .guide-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .guide-img-text { color: rgba(255,255,255,.85); font-size: 13px; font-weight: 700; }
  @media (min-width: 1024px) { .guide-img { width: 360px; height: 220px; } }
  .guide-body { flex: 1; padding: 12px; display: flex; flex-direction: column; gap: 5px; min-width: 0; }
  @media (min-width: 1024px) {
    .guide-body { padding: 28px; gap: 12px; background: var(--wine-dark); color: #fff; }
  }
  .guide-tag { align-self: flex-start; background: var(--t-orange); color: #fff; font-size: 10px; font-weight: 600; padding: 3px 8px; border-radius: 4px; }
  @media (min-width: 1024px) { .guide-tag { background: var(--pink); padding: 4px 10px; font-size: 11px; } }
  .guide-title { font-size: 15px; font-weight: 700; line-height: 1.4; }
  @media (min-width: 1024px) { .guide-title { font-size: 24px; line-height: 1.35; } }
  .guide-desc { font-size: 11px; color: var(--ink-3); line-height: 16px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (min-width: 1024px) { .guide-desc { font-size: 13px; color: #C9B8BF; line-height: 20px; -webkit-line-clamp: 3; } }
  .guide-more { display: inline-flex; align-items: center; gap: 4px; color: var(--wine); font-size: 12px; font-weight: 600; margin-top: auto; }
  @media (min-width: 1024px) { .guide-more { color: #fff; background: var(--pink); border-radius: 20px; padding: 10px 18px; font-size: 13px; align-self: flex-start; } }
</style>
