---
import { SOCIAL } from '../data/site';
---

<div class="wc-card">
  <div class="wc-qr">
    <img src={SOCIAL.wechatQr} alt="公众号二维码" width="100%" height="100%" style="border-radius:6px; object-fit:cover;" />
  </div>
  <div class="wc-info">
    <h3>{SOCIAL.wechatName} 公众号</h3>
    <p>每天推送塞尔维亚华人要闻、使馆/商会动态</p>
    <div class="wc-btns">
      <a href="#wechat-mp" class="btn-wc" data-mp>公众号</a>
      <a href={SOCIAL.channelUrl} class="btn-wc ghost" data-mp>视频号</a>
    </div>
  </div>
</div>

<script>
  // 公众号链接占位：#wechat-mp 注册后替换为真实链接，此处点击给提示
  document.querySelectorAll('[data-mp]').forEach((el) => {
    el.addEventListener('click', (e) => {
      const href = (el as HTMLAnchorElement).getAttribute('href');
      if (!href || href === '#' || href === '#wechat-mp') {
        e.preventDefault();
        const toast = document.getElementById('toast');
        if (toast) {
          toast.textContent = '公众号链接待配置，敬请关注';
          toast.classList.add('show');
          setTimeout(() => toast.classList.remove('show'), 2000);
        }
      }
    });
  });
</script>

<style>
  .wc-card {
    margin: 12px 16px 0;
    background: var(--wine-dark);
    color: #fff;
    border-radius: var(--r-lg);
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  @media (min-width: 1024px) {
    .wc-card { margin: 0; padding: 18px; border-radius: var(--r-lg); }
  }
  .wc-qr {
    width: 64px; height: 64px;
    background: #fff; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    color: var(--ink-3); font-size: 10px; flex-shrink: 0;
    overflow: hidden;
  }
  @media (min-width: 1024px) { .wc-qr { width: 80px; height: 80px; border-radius: 10px; } }
  .wc-info { flex: 1; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .wc-info h3 { font-size: 15px; font-weight: 700; }
  @media (min-width: 1024px) { .wc-info h3 { font-size: 16px; } }
  .wc-info p { font-size: 11px; color: #C9B8BF; }
  .wc-btns { display: flex; gap: 8px; }
  .btn-wc {
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--pink); color: #fff;
    border-radius: 13px; padding: 6px 12px; font-size: 11px; font-weight: 600;
    transition: all .2s;
  }
  .btn-wc:hover { background: #E83A5A; }
  .btn-wc.ghost { background: #3A2430; color: #E8DDE1; border: 1px solid #6E4A58; }
  .btn-wc.ghost:hover { background: #4A2F3D; }
</style>
